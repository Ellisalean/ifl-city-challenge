      "default": 30,
      "min": 15,
      "max": 60,
      "step": 5
    },
    {
      "name": "maxStrikes",
      "type": "number",
      "label": "Max Strikes Allowed",
      "default": 3,
      "min": 1,
      "max": 5,
      "step": 1
    },
    {
      "name": "passThresholdPercent",
      "type": "number",
